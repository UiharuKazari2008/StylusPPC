<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Storage passthrough of the whole phone or chosen folders as \Storage Card. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Microphone passthrough to the guest's audio input. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Camera passthrough: the phone's camera as Windows Mobile's (only while the guest uses it). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Mirroring signal, operator, data type and Wi-Fi into the guest's status icons. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The guest's network card reaches the internet through the app's user-mode NAT. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Windows Mobile's vibrator, passed through. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The phone's GPS as an NMEA receiver on the guest's COM1. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeping Windows Mobile running in the background (music, sync), with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phone calls from Windows Mobile's Phone app (CallBridge.kt, CallService.kt): placing and
         ending calls, and the screen-off-at-the-ear lock while Windows Mobile shows a call. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Incoming calls ringing in Windows Mobile without the dialer role: the caller's number. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Incoming calls while PocketStylus is in the background: Windows Mobile's screen over other apps,
         or a full-screen call notification over the lock screen (CallOverlay.kt, CallBridge.kt). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Text messages to and from Windows Mobile (SmsBridge.kt). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <!-- Contacts and calendar sync with Windows Mobile (PimSync.kt). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Infrared beams to nearby PocketStylus phones over Bluetooth LE (BleIrTransport.kt): scanning
         (never used for location), advertising and GATT links. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Send via Bluetooth from Windows Mobile: finding the phone's Bluetooth share target. -->
    <queries>
        <!-- Launcher (AndroidApps.kt): the phone's apps for Windows Mobile's Android Apps folder and the dock. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- Phone calls: tel: dial pads are passed on to the phone's own dialer (DialActivity). -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.WMDroid"
        android:supportsRtl="true">

        <!-- Android 16 ignores orientation locks on large screens; the emulator must stay portrait
             (the phone's orientation is passed to Windows Mobile instead). -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetupActivity" android:exported="false" />
        <!-- PocketStylus as the phone's home app (Settings > Launcher): brings the one emulator forward
             (HomeActivity.kt). Its own task, so the emulator's task stays an ordinary one. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- "Add to home screen" while PocketStylus is the launcher: a program in Windows Mobile's Start menu. -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".InstallShortcutReceiver"
            android:exported="true"
            android:permission="com.android.launcher.permission.INSTALL_SHORTCUT">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>
        <activity android:name=".AndroidAppsActivity" android:exported="false" android:label="Launcher" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="Settings" />
        <activity android:name=".DeviceSettingsActivity" android:exported="false" android:label="Device Settings" />
        <activity android:name=".StorageFoldersActivity" android:exported="false" android:label="Storage folders" />
        <activity
            android:name=".EmulatorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection|colorMode"
            android:theme="@style/Theme.WMDroid.Fullscreen" />
        <service
            android:name=".BackgroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Files Windows Mobile sends via Bluetooth, shared from the helper's mailbox. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".LockAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/lock_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- Phone calls (CallService.kt). The in-call service runs in its own process: handing calls
             to the phone's dialer ends that process only, and Telecom then connects the system
             dialer's in-call screen. Holding the dialer role also needs DialActivity. -->
        <service
            android:name=".WmInCallService"
            android:process=":call"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <service android:name=".CallLinkService" android:process=":call" android:exported="false" />
        <activity
            android:name=".DialActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <activity android:name=".CallSettingsActivity" android:exported="false" android:label="Phone calls" />
        <activity android:name=".PimSettingsActivity" android:exported="false" android:label="Contacts &amp; calendar" />
        <activity android:name=".InfraredSettingsActivity" android:exported="false" android:label="Infrared" />
        <!-- Text messages for Windows Mobile (SmsBridge.kt): incoming SMS into the queue, quick replies. -->
        <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SmsReplyReceiver" android:exported="false" />
        <!-- Accept / Reject for Windows Mobile's contact and calendar changes (PimSync.kt). -->
        <receiver android:name=".PimDecisionReceiver" android:exported="false" />
    </application>
</manifest>
